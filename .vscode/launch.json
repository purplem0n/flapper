{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Debug",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_development.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Prod Release",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_production.dart",
      "flutterMode": "release"
    },
    {
      "name": "Web Debug",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_development.dart",
      "flutterMode": "debug",
      "args": [
        "-d", "chrome",
        "--web-port=8008"
      ]
    }
  ]
}
